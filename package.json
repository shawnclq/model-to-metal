{
  "name": "model-to-metal",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive game that teaches the GenAI infrastructure stack, from inside the model down to GPU clusters.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:parity": "playwright test --project=parity",
    "test:visual": "playwright test --project=visual",
    "test:loading": "playwright test --project=loading",
    "test:pack": "playwright test --project=pack",
    "parity:update": "PARITY_UPDATE=1 playwright test --project=parity",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build && npm run test:parity && npm run test:visual && npm run test:loading && npm run test:pack"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "jsdom": "^29.1.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
